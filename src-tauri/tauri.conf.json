{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klyppr",
  "version": "3.1.0",
  "identifier": "com.klyppr.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Klyppr",
        "width": 1160,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/muzafferkadir/klyppr-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QUFBMEI2QTYyQzY0MzAKUldRd1pDeW10cUNxbU81T3N2eUMwYit4VzBFTGN0R0ZuS3FzWUJxczM4TkwvOENmUExxSHdLakEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
